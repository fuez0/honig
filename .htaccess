# Honig-Website auf honig.x10.mx
DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On
# immer https und ohne www
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://honig.x10.mx%{REQUEST_URI} [R=301,L]
</IfModule>

# Service Worker und HTML nie zwischenspeichern, damit Änderungen sofort ankommen
<IfModule mod_headers.c>
<FilesMatch "(sw\.js|\.html)$">
Header set Cache-Control "no-cache"
</FilesMatch>
<FilesMatch "\.(sql|md)$">
Require all denied
</FilesMatch>
</IfModule>

<IfModule mod_mime.c>
AddType application/manifest+json .json
AddType image/svg+xml .svg
</IfModule>
